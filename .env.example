# Cereal Milk landing, environment.
#
# The site runs without any secrets; every section below is OPTIONAL and
# rollout-safe. Add only what you need and redeploy.

# PostHog analytics (US cloud). OPTIONAL and rollout-safe.
# Set the client-side key (phc_..., public and safe to commit) to turn on
# consent-gated traffic analytics, funnel tracking, and session replay across
# cerealmilk.sh + /docs + /sentry. Get the key at https://us.posthog.com →
# Project Settings. With no key set the site runs unchanged.
NEXT_PUBLIC_POSTHOG_KEY=phc_example_key_replace_me
# PostHog ingestion host. US cloud by default; leave unset to use
# https://us.i.posthog.com. Set only if your project is on the EU cloud.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side download tracking. OPTIONAL and rollout-safe.
# The same PostHog project key, used by the /download file routes to log every
# GET server-side (anonymous, consent-independent, ad-blocker-proof). Leave
# unset and downloads are still served, just not logged.
DOWNLOAD_TRACK_SECRET=

# Waitlist (POST /api/waitlist): OPTIONAL and rollout-safe.
# With none of these set, signups are validated and logged (never lost) and the form
# still reports success. Set either, both, or neither, no code change needed.
#
#   WAITLIST_WEBHOOK_URL: POST each signup as JSON to any endpoint
#                          (Zapier / Make / your own handler).
#   RESEND_API_KEY + RESEND_AUDIENCE_ID: add the contact to a Resend audience
#                          (the mailing list). Get these from the Resend dashboard.
WAITLIST_WEBHOOK_URL=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Lifecycle drip (nurture + activation sequences). OPTIONAL and rollout-safe.
# The Day-0 welcome email only needs RESEND_API_KEY above. The follow-up drip
# (N1-N6 nurture, A1-A5 activation) additionally needs a contact store + the
# daily cron + a few secrets. With UPSTASH_* unset the whole drip is inert; the
# welcome email and the rest of the site keep working unchanged.
#
#   UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
#       The contact store (drip state). Create a free Upstash Redis DB, or use
#       Vercel KV (Storage → Create → KV) which exposes these same two vars.
#
#   CRON_SECRET
#       Protects GET /api/cron/drip. Vercel Cron (see vercel.json) sends it as
#       `Authorization: Bearer <CRON_SECRET>` automatically. Any long random
#       string. Required for the daily send to run.
#
#   LIFECYCLE_INGEST_SECRET
#       Protects POST /api/lifecycle. The Mac app sends usage signals
#       (whatsapp_connected, crm_linked, first_sync, ...) with header
#       `x-lifecycle-secret: <value>` so the activation sequence advances/skips.
#
#   UNSUBSCRIBE_SECRET
#       Signs the unsubscribe links in every lifecycle email (HMAC over the
#       address; see src/lib/drip/unsub.ts + /api/unsubscribe). Any long
#       random string. Falls back to LIFECYCLE_INGEST_SECRET, so setting that
#       is enough; with NEITHER set, unsubscribe links are unsigned and the
#       endpoint accepts unsigned requests (the legacy behavior).
#
#   WAITLIST_EMAIL_FROM / WAITLIST_EMAIL_REPLY_TO  (optional overrides)
#       The From and Reply-To on every lifecycle email. Defaults:
#       "Daniel Hull at Cereal Milk <clippy@updates.cerealmilk.sh>" and
#       "clippy@cerealmilk.sh". Until updates.cerealmilk.sh is verified in
#       Resend, set FROM to an address on the verified apex, e.g.
#       "Clippy @ Cereal Milk <clippy@cerealmilk.sh>" (the value live in prod).
#
#   INQUIRY_TO  (optional override)
#       Where /api/inquiry sends the brief from /contact and /demo. Defaults
#       to AUTHOR.email in src/lib/site.ts. Set this when the notification
#       inbox is not the address the site publishes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
LIFECYCLE_INGEST_SECRET=
UNSUBSCRIBE_SECRET=
WAITLIST_EMAIL_FROM=
WAITLIST_EMAIL_REPLY_TO=

# Dev-only: OPTIONAL. Set to "1" to force the screenshot capture hints on
# outside of development (they show automatically when NODE_ENV !== production).
# Leave unset in production.
NEXT_PUBLIC_SHOW_SHOT_HINTS=
